# Copy to .env in this directory and fill in, then run the demo from here
# (examples/demo): key paths and the keys/ directory are resolved relative to
# the current working directory.
#
# The demo can run three relying parties — Singpass Login, Myinfo, and Myinfo
# Business (Corppass) — and enables each one whose *_CLIENT_ID is set. Set at
# least one. The rest have sensible staging defaults.

# --- Shared ---

# Singpass FAPI 2.0 issuer (used by both Singpass apps unless overridden per
# app). Its .well-known/openid-configuration is fetched at startup; every
# endpoint (auth, token, PAR, jwks, userinfo) comes from there.
SINGPASS_ISSUER=https://stg-id.singpass.gov.sg/fapi

# This app's externally-reachable base URL. Each app's redirect URI is
# <base>/<app>/callback (e.g. http://localhost:8088/login/callback) and must
# exactly match what you registered for that client.
APP_BASE_URL=http://localhost:8088

# TCP listen address.
APP_ADDR=:8088

# authentication_context_type — the flow the user is authenticating for.
# This is a Login-app-only parameter (Singpass rejects it on Myinfo requests),
# so it applies to the Login app only. APP_AUTHENTICATION_DEFAULT is standard.
SINGPASS_AUTH_CONTEXT_TYPE=APP_AUTHENTICATION_DEFAULT

# Optional level of assurance (urn:singpass:authentication:loa:2 or :3).
# Only usable if Singpass has whitelisted your client for acr_values;
# otherwise leave blank (the default). Sent by the Singpass Login and Myinfo
# apps; never by Myinfo Business (Corppass).
SINGPASS_ACR_VALUES=

# --- Singpass Login (authentication only) ---
# Enabled when SINGPASS_LOGIN_CLIENT_ID is set. Generate keys with
#   go run ./cmd/keygen
# then register keys/login's printed JWKS with this Singpass client.
SINGPASS_LOGIN_CLIENT_ID=
SINGPASS_LOGIN_SCOPES="email mobileno name openid user.identity"
SINGPASS_LOGIN_SIG_KEY_PATH=keys/login/sig.pem
SINGPASS_LOGIN_SIG_KID=login-sig-1
SINGPASS_LOGIN_ENC_KEY_PATH=keys/login/enc.pem
SINGPASS_LOGIN_ENC_KID=login-enc-1
# SINGPASS_LOGIN_ISSUER=   # optional per-app issuer override

# --- Myinfo (authentication + person data via /userinfo) ---
# Enabled when MYINFO_CLIENT_ID is set. Register keys/myinfo's printed JWKS
# with this Singpass client, and make sure the person-data scopes below are
# whitelisted for it.
MYINFO_CLIENT_ID=
MYINFO_SCOPES="aliasname birthcountry dialect dob email employmentsector hanyupinyinaliasname hanyupinyinname hdbtype housingtype marriedname mobileno name nationality openid passexpirydate passportexpirydate passportnumber passstatus passtype race regadd residentialstatus secondaryrace sex uinfin"
MYINFO_SIG_KEY_PATH=keys/myinfo/sig.pem
MYINFO_SIG_KID=myinfo-sig-1
MYINFO_ENC_KEY_PATH=keys/myinfo/enc.pem
MYINFO_ENC_KID=myinfo-enc-1
# MYINFO_ISSUER=   # optional per-app issuer override

# --- Myinfo Business / Corppass (authentication + corporate data via /userinfo) ---
# The corporate Myinfo product, on the *Corppass* FAPI 2.0 authorization
# server (a different issuer — note there is no "/fapi" path suffix). Same
# protocol as Singpass; different scope namespaces (entity.* / user.* /
# corppass.*) and a /userinfo response that can carry several data blocks
# (entity_info / person_info / corppass_info / auth_info / tp_auth_info).
# Enabled when MYINFO_BIZ_CLIENT_ID is set. Register keys/myinfobiz's printed
# JWKS with this Corppass client and make sure the scopes below are whitelisted.
MYINFO_BIZ_CLIENT_ID=
MYINFO_BIZ_SCOPES="openid entity.basic_profile.name user.name corppass.email"
MYINFO_BIZ_SIG_KEY_PATH=keys/myinfobiz/sig.pem
MYINFO_BIZ_SIG_KID=myinfobiz-sig-1
MYINFO_BIZ_ENC_KEY_PATH=keys/myinfobiz/enc.pem
MYINFO_BIZ_ENC_KID=myinfobiz-enc-1
# MYINFO_BIZ_ISSUER=https://stg-id.corppass.gov.sg   # optional per-app issuer override

# If set, log outbound PAR/token/userinfo requests (method, URL, form body)
# to stderr (staging only — the PAR/token dump includes the client assertion).
# SP_DEBUG_HTTP=1
